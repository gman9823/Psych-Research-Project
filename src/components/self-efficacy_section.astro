---
import Layout from '../layout/Layout.astro';
---
<Layout>
    <section>
        <h2>The New General Self Efficacy Scale</h2>
        <p>
            This is the New General Self-Efficacy Scale (NGSE) developed by Chen et al. (2001). It is based on a 5-point Likert scale.
        </p>
        <p>
            Please rate your agreement with each statement on a scale from 1 (strongly disagree) to 5 (strongly agree).
        </p>
        <form>
            <div class="question-card">
                <p class="question-text">1. I will be able to achieve most of the goals that I set for myself.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 1" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 1" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 1" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 1" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 1" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <div class="question-card">
                <p class="question-text">2. When facing difficult tasks, I am certain that I will accomplish them.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 2" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 2" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 2" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 2" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 2" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <div class="question-card">
                <p class="question-text">3. In general, I think that I can obtain outcomes that are important to me.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 3" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 3" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 3" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 3" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 3" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <div class="question-card">
                <p class="question-text">4. I believe I can succeed at most any endeavor to which I set my mind.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 4" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 4" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 4" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 4" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 4" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <div class="question-card">
                <p class="question-text">5. I will be able to successfully overcome many challenges.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 5" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 5" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 5" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 5" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 5" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <div class="question-card">
                <p class="question-text">6. I am confident that I can perform effectively on many different tasks.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 6" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 6" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 6" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 6" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 6" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <div class="question-card">
                <p class="question-text">7. Compared to other people, I can do most tasks very well.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 7" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 7" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 7" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 7" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 7" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <div class="question-card">
                <p class="question-text">8. Even when things are tough, I can perform quite well.</p>
                <div class="likert-scale">
                    <label>
                        <input type="radio" name="Self-Efficacy Question 8" value="1" />
                        <span>1</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 8" value="2" />
                        <span>2</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 8" value="3" />
                        <span>3</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 8" value="4" />
                        <span>4</span>
                    </label>
                    <label>
                        <input type="radio" name="Self-Efficacy Question 8" value="5" />
                        <span>5</span>
                    </label>
                </div>
            </div>
            <button type="button" data-step="3">Previous</button>
            <button type="button" data-submit="/submit-successful">Submit</button>
        </form>
    </section>
    <footer>
        <a href="https://sparqtools.org/mobility-measure/new-general-self-efficacy-scale/#all-survey-questions">Source: Stanford University</a>
    </footer>
</Layout>

<script>
    document.querySelectorAll<HTMLButtonElement>('[data-submit]').forEach((button) => {
        button.addEventListener('click', async () => {
            const currentStep = document.getElementById('step4');
            const radioGroups = currentStep?.querySelectorAll<HTMLInputElement>('input[type="radio"]') ?? [];
            const groupNames = [...new Set(Array.from(radioGroups).map(radio => radio.name))];
            const unanswered = groupNames.filter((groupName) => (
                !currentStep?.querySelector(`input[name="${groupName}"]:checked`)
            ));

            if (unanswered.length > 0) {
                alert('Please answer all questions.');
                return;
            }

            // The final radio collection is merged across every visible survey
            // section so both the API and session result receive the full study data.
            const answers: Record<string, string> = {};
            document.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked').forEach((radio) => {
                answers[radio.name] = radio.value;
            });
            document.querySelectorAll<HTMLInputElement>('input[name]:not([type="radio"])').forEach((input) => {
                if (input.value) answers[input.name] = input.value;
            });
            document.querySelectorAll<HTMLSelectElement>('select[name]').forEach((select) => {
                answers[select.name] = select.value;
            });

            let response: Response;
            try {
                response = await fetch('/api/survey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(answers)
                });
            } catch {
                window.location.href = '/submission-failed';
                return;
            }

            if (!response.ok) {
                window.location.href = '/submission-failed';
                return;
            }

            // Session storage allows the success page to calculate a participant-
            // facing score without exposing the database to an additional request.
            sessionStorage.setItem('researchSurveyAnswers', JSON.stringify(answers));
            window.location.href = button.dataset.submit ?? '/submit-successful';
        });
    });
</script>

<style>
    section {
        margin-bottom: 20px;
    }
    h2 {
        color: #988558;
    }
    p {
        color: #666;
    }
    form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    label {
        display: block;
        margin-bottom: 5px;
        color: #333;
        font-weight: bold;
    }
    input {
        padding: 5px;
        border: 1px solid #ccc;
        border-radius: 3px;
        width: 200px;
        background-color: #f5f5dc;
    }
    button {
        align-self: center;
        display: block;
        margin: 0 auto;
        padding: 10px 20px;
        background-color: #f5f5dc;
        color: #333;
        border: none;
        cursor: pointer;
    }
    button:hover {
        background-color: #e0e0d1;
    }

    div.question-card {
        margin-bottom: 20px;
    }

    p.question-text {
        font-weight: bold;
        margin-bottom: 10px;
    }
    
    div.likert-scale {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        /* flex-direction: row; */
        /* justify-content: flex-start; */
        /* align-items: flex-start; */
        gap: 4px;
        margin-top: 12px;
        margin-bottom: 20px;
        width: 100%;
        max-width: 760px;
        overflow-x: auto;
    }

    .likert-scale label {
        display: flex;
            align-items: flex-start;
        justify-content: flex-start;
        font-size: 14px;
        font-weight: normal;
        cursor: pointer;
        gap: 4px;
    }

    .likert-scale input[type="radio"] {
        scale: 1.2;
        margin: 1px;
        padding: 1px;
        width: auto;
        background-color: transparent;
        gap: 4px;
    }

    @media (max-width: 600px) {
        div.likert-scale {
            gap: 2px;
        }

        .likert-scale label {
            min-height: 48px;
            font-size: 12px;
        }
    }
</style>